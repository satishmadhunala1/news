PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata
INTERNAL_API_SECRET=change-me

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/personal_news_assistant?retryWrites=true&w=majority

GNEWS_API_KEY=
GNEWS_BASE_URL=https://gnews.io/api/v4

NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

GOOGLE_NEWS_RSS_ENABLED=true

NEWSDATA_API_KEY=
NEWSDATA_BASE_URL=https://newsdata.io/api/1
NEWSDATA_ENABLED=true

GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_ENABLED=true

ONEINDIA_TELUGU_RSS_ENABLED=true
TELUGU_RSS_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

SCHEDULER_ENABLED=true
INTERVAL_FETCH_CRON=*/30 * * * *
MORNING_BRIEFING_CRON=0 9 * * *
AFTERNOON_UPDATE_CRON=0 13 * * *
EVENING_BRIEFING_CRON=0 19 * * *
MAX_ARTICLES_PER_BRIEFING=10

# Public backend (Render)
PUBLIC_BACKEND_URL=https://news-qdnq.onrender.com

# Frontend origin(s) for CORS — comma-separated OK
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:3001

